# Configurações da API de IA para Geração de Capas
IA_KEY=seu_token_de_api_aqui
IA_API_URL=https://api.openai.com/v1/images/generations
IA_MODEL_NAME=dall-e-3

# Integração Google Colab CLI (Execução Remota de OCR / saloppdf com GPU)
COLAB_SESSION_NAME=openscimd-worker
COLAB_ACCELERATOR=gpu
COLAB_GPU_TYPE=T4
COLAB_AUTO_STOP=true
