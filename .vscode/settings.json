{
    "cSpell.language": "pt-BR",
    "cSpell.enabledFileTypes": {
        "markdown": true,
        "*": false
    },
    "cSpell.autocorrect": true,
    "cSpell.useGitignore": false,
    "files.exclude": {
        "assets/images/originals": true,
        "assets/covers/originals": false,
        "artfacts-saloppdf": true,
        "assets/ilustrations": true,
        ".venv": true,
        "legacy_scripts": true,
        "**/__pycache__": true,
        ".agents": false,
        ".github": true
    },
    "search.exclude": {
        "**/data": false,
        "**/content/books": true,
        "**/content/articles": true
    },
    "cSpell.words": [
        "frontmatter",
        "loop",
        "openscimd",
        "paper",
        "reputacional",
        "tokenização",
        "Verney",
        "Zenodo"
    ]
}
